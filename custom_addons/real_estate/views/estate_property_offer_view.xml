<odoo>
    <data>

        <record id="estate_property_offer_list_view" model="ir.ui.view">
            <field name="name">estate.property.offer.list.view</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <list editable="top" decoration-danger="status == 'refused'"
                    decoration-success="status == 'accepted'">
                    <field name="price" />
                    <field name="partner_id" />
                    <field name="property_type_id"/>
                    <field name="status" invisible="1" nolabel="1" />
                    <field name="validity" />
                    <field name="date_deadline" />
                    <button name="action_accept" type="object" string="Accept"
                        class="oe_highlight"
                        invisible="status in ('accepted', 'refused')" />
                    <button name="action_refuse" type="object" string="Refuse"
                        class="oe_secondary"
                        invisible="status in ('accepted', 'refused')" />
                </list>
            </field>
        </record>

        <record id="estate_property_offer_form_view" model="ir.ui.view">
            <field name="name">estate.property.offer.form.view</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <form string="Property offers">
                    <group>
                        <field name="price" />
                        <field name="partner_id" />
                        <field name="validity" />
                        <field name="date_deadline" />
                        <field name="status" />
                    </group>
                </form>
            </field>
        </record>

        <record id="estate_property_offer_action" model="ir.actions.act_window">
            <field name="name">Property offers</field>
            <field name="res_model">estate.property.offer</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[("property_type_id", "=", active_id)]</field>
        </record>


    </data>
</odoo>